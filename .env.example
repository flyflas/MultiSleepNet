# Copy this file to .env for local-only overrides.
# Keep real local paths, credentials, and machine-specific values out of git.
#
# Training and data path overrides. Defaults match config.py when unset.
MCSN_NUM_FOLD=10
MCSN_NUM_EPOCHS=45
MCSN_DATA_ROOT=/openbayes/home/MultiChannelSleepNet
MCSN_BATCH_SIZE=512

# Optional MLflow tracking configuration. Leave MLFLOW_TRACKING_URI empty to disable MLflow logging.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_TRACKING_TOKEN=
MLFLOW_EXPERIMENT_NAME=MultiChannelSleepNet
MLFLOW_RUN_NAME=
